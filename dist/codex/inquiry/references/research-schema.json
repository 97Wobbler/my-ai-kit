{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Inquiry Research Record v1",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "inquiry-research/v1"
    },
    "research_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "authority": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "A",
            "B",
            "C"
          ]
        },
        "approved_scope": {
          "type": "string",
          "minLength": 1
        },
        "experiment_contracts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contract"
          },
          "maxItems": 1000,
          "minItems": 0
        }
      },
      "required": [
        "mode",
        "approved_scope",
        "experiment_contracts"
      ],
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "properties": {
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "limit": {
          "type": "number",
          "minimum": 0
        },
        "spent": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "unit",
        "limit",
        "spent"
      ],
      "additionalProperties": false
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      },
      "maxItems": 500,
      "minItems": 0
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      },
      "maxItems": 3000,
      "minItems": 0
    },
    "paths": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/path"
      },
      "maxItems": 100,
      "minItems": 0
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/prerequisite"
      },
      "maxItems": 1000,
      "minItems": 0
    },
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/decision"
      },
      "maxItems": 5000,
      "minItems": 0
    },
    "recoveries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/recovery"
      },
      "maxItems": 1000,
      "minItems": 0
    },
    "documents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/document"
      },
      "maxItems": 1000,
      "minItems": 0
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      },
      "maxItems": 1000,
      "minItems": 0
    }
  },
  "required": [
    "schema",
    "research_id",
    "title",
    "revision",
    "authority",
    "budget",
    "nodes",
    "edges",
    "paths",
    "prerequisites",
    "decisions",
    "recoveries",
    "documents",
    "evidence"
  ],
  "additionalProperties": false,
  "$defs": {
    "document": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "reference",
        "version",
        "summary"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "type": "string",
          "enum": [
            "user_provided",
            "workspace_observed",
            "experiment_observed",
            "external_evidence",
            "retrospective_reconstruction"
          ]
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 1000,
          "minItems": 0
        }
      },
      "required": [
        "id",
        "reference",
        "summary",
        "provenance",
        "conditions"
      ],
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "goal",
            "milestone",
            "hypothesis",
            "experiment",
            "decision"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "type": "string",
          "enum": [
            "draft",
            "active",
            "paused",
            "complete",
            "exhausted",
            "superseded"
          ]
        },
        "evidence_state": {
          "type": "string",
          "enum": [
            "not_tested",
            "inconclusive",
            "supported",
            "challenged",
            "mixed"
          ]
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 1000,
          "minItems": 0
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 1000,
          "minItems": 0,
          "uniqueItems": true
        },
        "document_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 1000,
          "minItems": 0,
          "uniqueItems": true
        },
        "parent_id": {
          "type": "string",
          "minLength": 1
        },
        "success_criterion": {
          "type": "string",
          "minLength": 1
        },
        "priority": {
          "type": "string",
          "enum": [
            "primary",
            "secondary"
          ]
        },
        "mandatory": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "type",
        "label",
        "summary",
        "state",
        "conditions",
        "evidence_refs",
        "document_refs"
      ],
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "contributes_to",
            "requires",
            "supports",
            "challenges",
            "tests",
            "informs",
            "supersedes"
          ]
        },
        "assessment": {
          "type": "string",
          "enum": [
            "unknown",
            "supported",
            "challenged",
            "mixed"
          ]
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 1000,
          "minItems": 0
        }
      },
      "required": [
        "id",
        "from",
        "to",
        "type",
        "assessment",
        "conditions"
      ],
      "additionalProperties": false
    },
    "path": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "node_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 1000,
          "minItems": 1,
          "uniqueItems": true
        },
        "goal_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 1000,
          "minItems": 1,
          "uniqueItems": true
        },
        "state": {
          "type": "string",
          "enum": [
            "draft",
            "adopted",
            "paused",
            "exhausted",
            "superseded"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "cost_estimate": {
          "type": "string",
          "minLength": 1
        },
        "likelihood_estimate": {
          "type": "string",
          "minLength": 1
        },
        "decision_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "label",
        "node_ids",
        "goal_ids",
        "state",
        "rationale",
        "cost_estimate",
        "likelihood_estimate"
      ],
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "properties": {
        "perspective": {
          "type": "string",
          "minLength": 1
        },
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "disposition": {
          "type": "string",
          "enum": [
            "accepted",
            "rejected",
            "deferred"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "perspective",
        "claim",
        "disposition",
        "reason"
      ],
      "additionalProperties": false
    },
    "decision": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "timestamp": {
          "type": "string",
          "minLength": 1
        },
        "actor": {
          "type": "string",
          "enum": [
            "user",
            "agent"
          ]
        },
        "action": {
          "type": "string",
          "enum": [
            "propose",
            "adopt_strategy",
            "continue",
            "advance",
            "hold",
            "stop",
            "pivot",
            "review",
            "change_criterion",
            "final_adoption"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "node_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 1000,
          "minItems": 0,
          "uniqueItems": true
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 1000,
          "minItems": 0,
          "uniqueItems": true
        },
        "document_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 1000,
          "minItems": 0,
          "uniqueItems": true
        },
        "alternatives": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 1000,
          "minItems": 0,
          "uniqueItems": true
        },
        "reviews": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/review"
          },
          "maxItems": 1000,
          "minItems": 0
        },
        "criterion_before": {
          "type": "string",
          "minLength": 1
        },
        "criterion_after": {
          "type": "string",
          "minLength": 1
        },
        "authorization_ref": {
          "type": "string",
          "minLength": 1
        },
        "mode_at_decision": {
          "type": "string",
          "enum": [
            "A",
            "B",
            "C"
          ]
        }
      },
      "required": [
        "id",
        "timestamp",
        "actor",
        "action",
        "summary",
        "rationale",
        "node_ids",
        "evidence_refs",
        "document_refs",
        "alternatives",
        "reviews",
        "mode_at_decision"
      ],
      "additionalProperties": false
    },
    "recovery": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "path_id": {
          "type": "string",
          "minLength": 1
        },
        "failed_premise_id": {
          "type": "string",
          "minLength": 1
        },
        "adopted_at_decision_id": {
          "type": "string",
          "minLength": 1
        },
        "backtracks": {
          "type": "integer",
          "minimum": 0
        },
        "backtrack_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "reviewed_points": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 1000,
          "minItems": 0
        },
        "attempts_at_point": {
          "type": "integer",
          "minimum": 0
        },
        "attempt_limit": {
          "type": "integer",
          "minimum": 1
        },
        "spent": {
          "type": "number",
          "minimum": 0
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "stopped",
            "resolved"
          ]
        },
        "started_reason": {
          "type": "string",
          "minLength": 1
        },
        "reset_evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 1000,
          "minItems": 0,
          "uniqueItems": true
        },
        "prior_episode_id": {
          "type": "string",
          "minLength": 1
        },
        "reset_decision_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "path_id",
        "failed_premise_id",
        "adopted_at_decision_id",
        "backtracks",
        "backtrack_limit",
        "reviewed_points",
        "attempts_at_point",
        "attempt_limit",
        "spent",
        "status",
        "started_reason",
        "reset_evidence_refs"
      ],
      "additionalProperties": false
    },
    "prerequisite": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "target_id": {
          "type": "string",
          "minLength": 1
        },
        "operator": {
          "type": "string",
          "enum": [
            "all",
            "any"
          ]
        },
        "members": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 1000,
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "target_id",
        "operator",
        "members"
      ],
      "additionalProperties": false
    },
    "contract": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "approved_by_user": {
          "type": "boolean"
        },
        "scope_summary": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "reference",
        "approved_by_user",
        "scope_summary"
      ],
      "additionalProperties": false
    }
  }
}
